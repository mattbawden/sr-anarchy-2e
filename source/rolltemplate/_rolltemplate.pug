+templateWrapper('custom').header
  //- Create your template here
  +templateConditionalDisplay('name').template-name
    +div({class: 'sheet-template-name'})
      span.description {{name}}
  +characterLink
  +templateConditionalDisplay('result').template-row
    +div({class: 'sheet-template-result'})
      span.description {{result}} hits
  +templateConditionalDisplay('riskresult').template-row
    +div({class: 'sheet-template-riskresult'})
      span.description {{riskresult}} risk hits
  +templateConditionalDisplay('riskreduction').template-row
    +div({class: 'sheet-template-riskreduction'})
      span.description {{riskreduction}} risk reduction
  +templateConditionalDisplay('nethits').template-row
    +div({class: 'sheet-template-riskreduction'})
      span.description {{nethits}} net hits against threshold {{Threshold}}