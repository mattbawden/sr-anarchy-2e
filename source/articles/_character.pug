+div({name: 'character_container'}).character-container
    +div({name: 'character_header'}).character-header
        +input-label({label: 'STREETNAME', inputObj:{name: 'streetname', type: 'text'}})
        +input-label({label: 'CONCEPT', inputObj:{name: 'concept', type: 'text'}})
    +div({name: 'character_attributes'}).attributes-header
        label(class='header-label') STRENGTH
        label(class='header-label') AGILITY
        label(class='header-label') LOGIC
        label(class='header-label') WILLPOWER
        label(class='header-label') CHARISMA
        label(class='header-label') EDGE
        +input({name:'strength', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'agility', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'logic', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'willpower', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'charisma', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'edge', type:'number', value:'0',min: '1', max: '6'}).attribute-points
    +div({name: 'character_skills'}).skill-grid
        label(class='header-label') SKILL
        label(class='header-label') RATING
        label(class='header-label') BONUS
        label(class='header-label') TOTAL
        label(class='header-label') 
        label(class='skill-label') Athletics (S)
        +input({name:'athleticss',type:'number',value:'0', min:'0', max:'8',trigger:{affects:['athleticss_total']}}).skill-input
        +input({name:'athleticss bonus',type:'number',value:'0', trigger:{affects:['athletics_total']}}).skill-input
        +input({name:'athleticss total',type:'number',value:'0', trigger:{formula:'@{athleticss} + @{athleticss_bonus} + @{strength}'}}).skill-input
        +button({name: 'athleticss roll', value: '&{template:custom} {{name= @{streetname} | Athletics S Roll}} {{result=[[((@{athleticss_total}+?{Dice Modifier|0}-?{Risk Dice|0})d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})]]}} {{riskresult=[[((?{Risk Dice|0}d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})*2)]]}}'}).roll-button
        label(class='skill-label') Athletics (A)
        +input({name:'athleticsa',type:'number',value:'0', min:'0', max:'8',trigger:{affects:['athleticsa_total']}}).skill-input
