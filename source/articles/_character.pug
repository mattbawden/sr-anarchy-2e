+div({name: 'character_container'}).character-container
    +div({name: 'character_header'}).character-header
        +input-label({label: 'STREETNAME', inputObj:{name: 'streetname', type: 'text'}})
        +input-label({label: 'CONCEPT', inputObj:{name: 'concept', type: 'text'}})
    +div({name: 'character_attributes'}).attributes-header
        label(class='header-label') STRENGTH
        label(class='header-label') AGILITY
        label(class='header-label') LOGIC
        label(class='header-label') WILLPOWER
        label(class='header-label') CHARISMA
        label(class='header-label') EDGE
        +input({name:'strength', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'agility', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'logic', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'willpower', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'charisma', type:'number', value:'0',min: '1', max: '6'}).attribute-points
        +input({name:'edge', type:'number', value:'0',min: '1', max: '6'}).attribute-points
    +div({name: 'two_column'}).two-column
        +div({name: 'other_attributes'}).other-attributes
            label(class='other-label') ARMOR
            +input({name:'armor', type:'number', value:'0', min: '0'}).attribute-points
            label(class='other-label') PROTECTION
            +input({name:'protection', type:'number', value:'0', min: '0'}).attribute-points
            label(class='other-label') FIREWALL
            +input({name:'firewall', type:'number', value:'0', min: '0'}).attribute-points
            label(class='other-label') ESSENCE
            +input({name:'essence', type:'number', value:'6', min: '1', max: '6'}).attribute-points
        +div({name: 'wound_threshold'}).wound-threshold
            label(class='other-label') WOUNDS
            +input({name:'lightnum', type:'number', value:'0', min: '2',max:'3'}).attribute-points
            +input({name:'seriousnum', type:'number', value:'0', min: '1', max:'2'}).attribute-points
            +input({name:'incapnum', type:'number', value:'1', min: '1', max:'1'}).attribute-points
            label(class='other-label') CURRENT
            span(class='fill-box')
                +div({class:'radio-container'})
                    +input({name:'light1', type:'checkbox', value:'1', id:'light-1'}).radio-input
                    +input({name:'light2', type:'checkbox', value:'2', id:'light-2'}).radio-input
                    +input({name:'light3', type:'checkbox', value:'3', id:'light-3'}).radio-input
            span(class='fill-box')
                +div({class:'radio-container'})
                    +input({name:'serious1', type:'checkbox', value:'1', id:'serious-1'}).radio-input
                    +input({name:'serious2', type:'checkbox', value:'2', id:'serious-2'}).radio-input
            span(class='fill-box')
                +div({class:'radio-container'})
                    +input({name:'incap1', type:'checkbox', value:'1', id:'incap-1'}).radio-input
            label(class='other-label') THRESHOLDS
            label(class='other-label') LIGHT
            label(class='other-label') SERIOUS
            label(class='other-label') INCAP.
            +input({name:'armor_threshold', type:'text', value:'Armor', readonly:true}).attribute-points
            +input({name:'light_threshold', type:'number', value:'0', trigger:{formula:'@{strength} + @{armor}'}, readonly:true}).attribute-points
            +input({name:'serious_threshold', type:'number', value:'0', trigger:{formula:'@{strength} + @{armor} + 3'}, readonly:true}).attribute-points
            +input({name:'incap_threshold', type:'number', value:'0', trigger:{formula:'@{strength} + @{armor} + 6'}, readonly:true}).attribute-points
            +input({name:'prot_threshold', type:'text', value:'Protection', readonly:true}).attribute-points
            +input({name:'light_prot', type:'number', value:'0', trigger:{formula:'@{willpower} + @{protection}'}, readonly:true}).attribute-points
            +input({name:'serious_prot', type:'number', value:'0', trigger:{formula:'@{willpower} + @{protection} + 3'}, readonly:true}).attribute-points
            +input({name:'incap_prot', type:'number', value:'0', trigger:{formula:'@{willpower} + @{protection} + 6'}, readonly:true}).attribute-points
            +input({name:'matrix_threshold', type:'text', value:'Matrix', readonly:true}).attribute-points
            +input({name:'light_matrix', type:'number', value:'0', trigger:{formula:'@{firewall}'}, readonly:true}).attribute-points
            +input({name:'serious_matrix', type:'number', value:'0', trigger:{formula:'@{firewall} * 2'}, readonly:true}).attribute-points
            +input({name:'incap_matrix', type:'number', value:'0', trigger:{formula:'@{firewall} * 3'}, readonly:true}).attribute-points
    +div({name: 'character_skills'}).skill-grid
        label(class='header-label') SKILL
        label(class='header-label') RATING
        label(class='header-label') BONUS
        label(class='header-label') TOTAL
        label(class='header-label') RR
        label(class='header-label') 
        label(class='skill-label') Athletics (S)
        +input({name:'athleticss',type:'number',value:'0', min:'0', max:'8',trigger:{affects:['athleticss_total']}}).skill-input
        +input({name:'athleticss bonus',type:'number',value:'0', trigger:{affects:['athletics_total']}}).skill-input
        +input({name:'athleticss total',type:'number',value:'0', trigger:{formula:'@{athleticss} + @{athleticss_bonus} + @{strength}'}}).skill-input
        +input({name:'athleticss rr',type:'number',value:'0', min:'0', max:'3'}).skill-input
        +button({name: 'athleticss roll', value: '&{template:custom} {{name= @{streetname} | Athletics S Roll}} {{result=[[((@{athleticss_total}+?{Dice Modifier|0}-?{Risk Dice|0})d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})]]}} {{riskresult=[[((?{Risk Dice|0}d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})*2)]]}} {{riskreduction=[[@{athleticss_rr}]]}}'}).roll-button
        label(class='skill-label') Athletics (A)
        +input({name:'athleticsa',type:'number',value:'0', min:'0', max:'8',trigger:{affects:['athleticsa_total']}}).skill-input
        +input({name:'athleticsa bonus',type:'number',value:'0', trigger:{affects:['athletics_total']}}).skill-input
