        +button({name: 'athleticsa roll', value: '&{template:custom} {{name= @{streetname} | Athletics A Roll}} {{result=[[((@{athleticsa_total}+?{Dice Modifier|0}-?{Risk Dice|0})d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})]]}} {{riskresult=[[((?{Risk Dice|0}d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})*2)]]}} {{riskreduction=[[@{athleticsa_rr}]]}}'}).roll-button
