+div({name: 'character_container'}).character-container
    +repeating_section('shadowamps', 'gear', ['name','type','cost','level','effects'])
        +div({name:'ampsgrid'}).amps-grid
            +text({name:'name'}).amps-input
            +select({name:'type'}).amps-input
                +option({value:''})
                    |Select One
                +option({value:'quality'})
                    |Weapon
                +option({value:'contact'})
                    |Equipment
                +option({value:'augmentation'})
                    |Matrix
                +option({value:'magic'})
                    |Rigger
                +option({value:'resonance'})
                    |Medtech
            +text({name:'cost'}).amps-input
            +number({name:'level'}).amps-input
            +textarea({name:'effects'}).amps-input