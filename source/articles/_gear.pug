+div({name: 'gear_container'}).gear-container
    +repeating_section('gearamps', 'gear', ['name','type','cost','rating','dv','range','effects'])
        +div({name:'geargrid'}).gear-grid
            +text({name:'name'}).gear-input
            +select({name:'type'}).gear-input
                +option({value:''})
                    |Select One
                +option({value:'weapon'})
                    |Weapon
                +option({value:'equipment'})
                    |Equipment
                +option({value:'matrix'})
                    |Matrix
                +option({value:'rigger'})
                    |Rigger
                +option({value:'medtech'})
                    |Medtech
            +text({name:'cost'}).gear-input
            +number({name:'rating'}).gear-input
            +number({name:'dv'}).gear-input
            +text({name:'range'}).gear-input
            +textarea({name:'effects'}).gear-input