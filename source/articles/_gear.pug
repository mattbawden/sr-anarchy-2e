+div({name: 'weapon_container'}).weapon-container
    +repeating_section('weaponamps', 'weapon', ['name', 'skill','dv','range','effects','atk'])
        +div({name:'weapongrid'}).weapon-grid
            +text({name:'weaponname'}).weapon-input
            +select({name:'skill'}).weapon-input
                +option({value:'@{closecombata_total}'})
                    |Close Combat A
                +option({value:'@{closecombats_total}'})
                    |Close Combat S 
                +option({value:'@{rangeda_total}'})
                    |Ranged Weapons
            +number({name:'dv'}).weapon-input
            +select({name:'range'}).weapon-input
                +option({value:'c'})
                    |OK/-/-/-
                +option({value:'cs'})
                    |OK/OK/-/-
                +option({value:'csm'})
                    |OK/OK/OK/-
                +option({value:'csmd'})
                    |OK/OK/Dis/-
                +option({value:'cdsm'})
                    |Dis/OK/OK/-
                +option({value:'cdsmld'})
                    |Dis/OK/OK/Dis
                +option({value:'cdsmd'})
                    |Dis/OK/Dis/-
                +option({value:'sdmdl'})
                    |-/Dis/Dis/OK
                +option({value:'sml'})
                    |-/OK/OK/OK
                +option({value:'sdml'})
                    |-/Dis/OK/OK
                +option({value:'mdl'})
                    |-/-/Dis/OK
            +textarea({name:'effects'}).weapon-input
            +button({name:'weapon attack roll', value: '&{template:custom} {{name= @{streetname} | @{weaponname} Attack Roll}} {{Threshold=?{Threshold|3}}} {{DV=@{dv}}} [[ [[(@{skill}+?{Dice Modifier|0}-?{Risk Dice|0})d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})]] + [[((?{Risk Dice|0}d6>?{Advantage|Standard,5|Advantage,4|Disadvantage,6})*2)]] - ?{Threshold} ]] {{result= $[[0]]}} {{riskresult= $[[1]]}} {{riskreduction=@{rangeda_rr}}}  {{nethits=$[[2]]}}'}).roll-button
+div({name: 'gear_container'}).gear-container
    +repeating_section('gearamps', 'gear', ['name','type','cost','rating','effects'])
        +div({name:'geargrid'}).gear-grid
            +text({name:'name'}).gear-input
            +select({name:'type'}).gear-input
                +option({value:'weapon'})
                    |Weapon
                +option({value:'equipment'})
                    |Equipment
                +option({value:'matrix'})
                    |Matrix
                +option({value:'rigger'})
                    |Rigger
                +option({value:'medtech'})
                    |Medtech
            +text({name:'cost'}).gear-input
            +number({name:'rating'}).gear-input
            +textarea({name:'effects'}).gear-input